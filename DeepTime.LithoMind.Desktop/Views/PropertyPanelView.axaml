<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeepTime.LithoMind.Desktop.ViewModels.Pages"
             x:Class="DeepTime.LithoMind.Desktop.Views.PropertyPanelView"
             x:DataType="vm:PropertyPanelViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="属性窗口" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 刷新按钮 -->
                <Button Grid.Column="1" 
                        Content="🔄" 
                        ToolTip.Tip="刷新数据"
                        Command="{Binding RefreshDataCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="5"
                        Cursor="Hand"/>
                <!-- 清除按钮 -->
                <Button Grid.Column="2" 
                        Content="🗑️" 
                        ToolTip.Tip="清除数据"
                        Command="{Binding ClearDataCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="5"
                        Cursor="Hand"/>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Border Grid.Row="1" Background="#FAFAFA">
            <Grid>
                <!-- 无数据提示 -->
                <StackPanel IsVisible="{Binding !HasData}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无属性数据" 
                               FontSize="14" 
                               Foreground="#7F8C8D"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="请在综合柱状图中选择深度段" 
                               FontSize="12" 
                               Foreground="#95A5A6"
                               Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- 数据显示区域 -->
                <Grid IsVisible="{Binding HasData}" 
                      RowDefinitions="Auto,*,Auto">
                    
                    <!-- 井信息头部 -->
                    <Border Grid.Row="0" Background="#ECF0F1" Padding="10">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🛢️" FontSize="14"/>
                                <TextBlock Text="{Binding CurrentWellName}" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="#2C3E50"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📏" FontSize="12"/>
                                <TextBlock Text="{Binding CurrentDepthRange}" 
                                           FontSize="12" 
                                           Foreground="#7F8C8D"/>
                            </StackPanel>
                            <!-- 推理结果标记 -->
                            <Border IsVisible="{Binding ShowInferenceResults}"
                                    Background="#27AE60"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    HorizontalAlignment="Left"
                                    Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="🧠" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="AI智能推理结果" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <!-- 地震相推理结果标记 -->
                            <Border IsVisible="{Binding ShowSeismicInferenceResults}"
                                    Background="#3498DB"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    HorizontalAlignment="Left"
                                    Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="🌊" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="地震相AI推理结果" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- 深度段属性列表 - 可编辑 -->
                    <ScrollViewer Grid.Row="1" Padding="5">
                        <ItemsControl ItemsSource="{Binding DepthProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" 
                                            CornerRadius="6" 
                                            Padding="10" 
                                            Margin="5"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <!-- 深度范围标题 -->
                                            <Border Background="#3498DB" CornerRadius="4" Padding="8,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto,10,Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="起始:" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" 
                                                             Text="{Binding DepthStart, Mode=TwoWay}" 
                                                             FontSize="11"
                                                             Background="White"
                                                             Padding="4,2"
                                                             MinWidth="50"
                                                             HorizontalAlignment="Stretch"/>
                                                    <TextBlock Grid.Column="2" Text="m" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                                                    <TextBlock Grid.Column="4" Text="终止:" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="5" 
                                                             Text="{Binding DepthEnd, Mode=TwoWay}" 
                                                             FontSize="11"
                                                             Background="White"
                                                             Padding="4,2"
                                                             MinWidth="50"
                                                             HorizontalAlignment="Stretch"/>
                                                    <TextBlock Grid.Column="6" Text="m" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- 岩性/地震相 - 下拉选择+自定义输入 -->
                                            <Grid ColumnDefinitions="80,*">
                                                <!-- 动态标签：地震相时显示"地震相:"，否则显示"岩性:" -->
                                                <TextBlock Grid.Column="0" 
                                                           FontSize="12" 
                                                           Foreground="#7F8C8D"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !$parent[UserControl].((vm:PropertyPanelViewModel)DataContext).ShowSeismicInferenceResults}"
                                                           Text="岩性:"/>
                                                <TextBlock Grid.Column="0" 
                                                           FontSize="12" 
                                                           Foreground="#7F8C8D"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding $parent[UserControl].((vm:PropertyPanelViewModel)DataContext).ShowSeismicInferenceResults}"
                                                           Text="地震相:"/>
                                                <AutoCompleteBox Grid.Column="1" 
                                                                 Text="{Binding Lithology, Mode=TwoWay}" 
                                                                 ItemsSource="{Binding $parent[UserControl].((vm:PropertyPanelViewModel)DataContext).LithologyOptions}"
                                                                 FilterMode="Contains"
                                                                 FontSize="12"
                                                                 Watermark="选择或输入岩性..."
                                                                 MinHeight="28"/>
                                            </Grid>
                                            
                                            <!-- 沉积相 - 下拉选择+自定义输入 -->
                                            <Grid ColumnDefinitions="80,*">
                                                <TextBlock Grid.Column="0" 
                                                           Text="沉积相:" 
                                                           FontSize="12" 
                                                           Foreground="#7F8C8D"
                                                           VerticalAlignment="Center"/>
                                                <AutoCompleteBox Grid.Column="1" 
                                                                 Text="{Binding SedimentaryFacies, Mode=TwoWay}" 
                                                                 ItemsSource="{Binding $parent[UserControl].((vm:PropertyPanelViewModel)DataContext).SedimentaryFaciesOptions}"
                                                                 FilterMode="Contains"
                                                                 FontSize="12"
                                                                 Watermark="选择或输入沉积相..."
                                                                 MinHeight="28"/>
                                            </Grid>
                                            
                                            <!-- 地质描述 - 可编辑文本框 -->
                                            <Grid ColumnDefinitions="80,*">
                                                <TextBlock Grid.Column="0" 
                                                           Text="描述:" 
                                                           FontSize="12" 
                                                           Foreground="#7F8C8D"
                                                           VerticalAlignment="Top"
                                                           Margin="0,5,0,0"/>
                                                <TextBox Grid.Column="1" 
                                                         Text="{Binding GeologicalDescription, Mode=TwoWay}" 
                                                         FontSize="11" 
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="50"
                                                         MaxHeight="100"/>
                                            </Grid>
                                            
                                            <!-- 置信度 - 仅在推理结果时显示 -->
                                            <Border IsVisible="{Binding $parent[UserControl].((vm:PropertyPanelViewModel)DataContext).ShowInferenceResults}"
                                                    Background="#F0F8FF"
                                                    CornerRadius="4"
                                                    Padding="8"
                                                    Margin="0,5,0,0">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <TextBlock Grid.Column="0" 
                                                               Text="🎯 置信度:" 
                                                               FontSize="12" 
                                                               Foreground="#2C3E50"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Confidence}"
                                                                 Maximum="1.0"
                                                                 Height="8"
                                                                 Margin="8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="#27AE60"/>
                                                    <TextBlock Grid.Column="2"
                                                               FontSize="12"
                                                               Foreground="#27AE60"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding Confidence, StringFormat={}{0:P0}}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- JSON视图切换 -->
                    <Expander Grid.Row="2" Header="📄 JSON 数据视图" Padding="5">
                        <Border Background="#2C3E50" CornerRadius="4" Padding="10">
                            <ScrollViewer MaxHeight="200" 
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding JsonContent}" 
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="11" 
                                           Foreground="#ECF0F1"
                                           TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </Grid>
            </Grid>
        </Border>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding PropertyTitle}" 
                           FontSize="11" 
                           Foreground="#7F8C8D"/>
                <TextBlock Text="|" Foreground="#BDC3C7" FontSize="11"/>
                <TextBlock FontSize="11" Foreground="#95A5A6">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="共 {0} 个深度段">
                            <Binding Path="DepthProperties.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
