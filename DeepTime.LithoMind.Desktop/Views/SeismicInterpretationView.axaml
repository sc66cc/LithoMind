<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeepTime.LithoMind.Desktop.ViewModels.Pages"
             x:Class="DeepTime.LithoMind.Desktop.Views.SeismicInterpretationView"
             x:DataType="vm:SeismicInterpretationViewModel">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 道号范围选择对话框 -->
        <Border Grid.RowSpan="3" 
                IsVisible="{Binding ShowTraceRangeDialog}"
                Background="#80000000"
                ZIndex="1000">
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="0"
                    MaxWidth="500"
                    MaxHeight="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BoxShadow="0 4 20 2 #40000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 对话框标题 -->
                    <Border Grid.Row="0" Background="#3498DB" CornerRadius="8 8 0 0" Padding="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🧠" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="沉积相智能推理" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 对话框内容 -->
                    <Grid Grid.Row="1" Margin="20" RowDefinitions="Auto,Auto,Auto,Auto">
                        <!-- 说明文本 -->
                        <Border Grid.Row="0" Background="#EBF5FB" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="请设置道号范围进行地震相和沉积相智能推理分析，系统将利用AI算法识别地震相特征和沉积相类型。" 
                                       FontSize="12" 
                                       Foreground="#2C3E50" 
                                       TextWrapping="Wrap"/>
                        </Border>
                        
                        <!-- xLine范围 -->
                        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Text="xLine 道号范围" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="起始:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <NumericUpDown Grid.Column="1" 
                                                   Value="{Binding XLineStart, Mode=TwoWay}" 
                                                   Minimum="0"
                                                   Maximum="10000"
                                                   Increment="1"
                                                   FormatString="F0"
                                                   FontSize="12"
                                                   Padding="8,4"
                                                   Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="结束:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <NumericUpDown Grid.Column="3" 
                                                   Value="{Binding XLineEnd, Mode=TwoWay}" 
                                                   Minimum="0"
                                                   Maximum="10000"
                                                   Increment="1"
                                                   FormatString="F0"
                                                   FontSize="12"
                                                   Padding="8,4"/>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- inLine范围 -->
                        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="12">
                            <Grid RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Text="inLine 道号范围" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*">
                                    <TextBlock Grid.Column="0" Text="起始:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <NumericUpDown Grid.Column="1" 
                                                   Value="{Binding InLineStart, Mode=TwoWay}" 
                                                   Minimum="0"
                                                   Maximum="10000"
                                                   Increment="1"
                                                   FormatString="F0"
                                                   FontSize="12"
                                                   Padding="8,4"
                                                   Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="结束:" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <NumericUpDown Grid.Column="3" 
                                                   Value="{Binding InLineEnd, Mode=TwoWay}" 
                                                   Minimum="0"
                                                   Maximum="10000"
                                                   Increment="1"
                                                   FormatString="F0"
                                                   FontSize="12"
                                                   Padding="8,4"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- 对话框底部按钮 -->
                    <Border Grid.Row="2" BorderBrush="#ECF0F1" BorderThickness="0,1,0,0" Padding="16" Background="#FAFAFA" CornerRadius="0 0 8 8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="取消" 
                                    Command="{Binding CancelTraceRangeSelectionCommand}"
                                    Background="Transparent"
                                    BorderBrush="#95A5A6"
                                    BorderThickness="1"
                                    Foreground="#7F8C8D"
                                    Padding="20,8"
                                    CornerRadius="4"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button Content="开始推理" 
                                    Command="{Binding StartSeismicInferenceCommand}"
                                    Background="#27AE60"
                                    BorderThickness="0"
                                    Foreground="White"
                                    Padding="20,8"
                                    CornerRadius="4"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
        
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 左侧标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="地震解释剖面" FontSize="14" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="-" FontSize="14" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SectionName}" FontSize="14" Foreground="#1ABC9C" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- 右侧工具按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <!-- 显示选项 -->
                    <CheckBox Content="层位" 
                              IsChecked="{Binding ShowHorizons}"
                              Foreground="White"
                              FontSize="11"
                              VerticalAlignment="Center"/>
                    <CheckBox Content="断层" 
                              IsChecked="{Binding ShowFaults}"
                              Foreground="White"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="8,0"/>
                    <CheckBox Content="井" 
                              IsChecked="{Binding ShowWells}"
                              Foreground="White"
                              FontSize="11"
                              VerticalAlignment="Center"/>
                    <!-- 分隔线 -->
                    <Border Width="1" Background="#7F8C8D" Margin="8,2"/>
                    <!-- 放大按钮 -->
                    <Button Content="🔍+" 
                            ToolTip.Tip="放大"
                            Command="{Binding ZoomInCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand"/>
                    <!-- 缩放比例显示 -->
                    <Border Background="#34495E" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomLevelText}" 
                                   FontSize="12" 
                                   Foreground="White"
                                   MinWidth="45"
                                   TextAlignment="Center"/>
                    </Border>
                    <!-- 缩小按钮 -->
                    <Button Content="🔍-" 
                            ToolTip.Tip="缩小"
                            Command="{Binding ZoomOutCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand"/>
                    <!-- 重置缩放按钮 -->
                    <Button Content="🎯" 
                            ToolTip.Tip="重置视图"
                            Command="{Binding ResetZoomCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区 - 剖面图片显示（禁用滚动，使用自定义缩放） -->
        <Border Grid.Row="1" Background="#1a1a2e" ClipToBounds="True" x:Name="ImageContainer">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400">
                <!-- 无图片提示 -->
                <StackPanel IsVisible="{Binding !HasImage}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="60" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="地震解释剖面" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    <TextBlock Text="选择剖面查看数据" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- 剖面图片 - 居中显示，滚轮控制缩放 -->
                <Image Source="{Binding SectionImage}"
                       IsVisible="{Binding HasImage}"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                           ScaleY="{Binding ZoomLevel}"/>
                            <TranslateTransform X="{Binding PanOffsetX}"
                                               Y="{Binding PanOffsetY}"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>
        
        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="8,6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="剖面类型:" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding SectionType}" FontSize="11" Foreground="#2C3E50" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="位置:" FontSize="11" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding SectionPosition}" FontSize="11" Foreground="#2C3E50"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" 
                           Text="滚轮缩放 | 拖拽平移" 
                           FontSize="10" 
                           Foreground="#95A5A6"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
