<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DeepTime.LithoMind.Desktop"
             x:Class="DeepTime.LithoMind.Desktop.App"
             RequestedThemeVariant="Light">
             <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <!-- Dock.Avalonia.Themes.Fluent 菜单/拖拽提示中文化：这些键由 Dock 主题通过 DynamicResource 读取。 -->
        <x:String x:Key="DragPreviewControlDockString">停靠</x:String>
        <x:String x:Key="DragPreviewControlFloatString">浮动</x:String>
        <x:String x:Key="DragPreviewControlNoneString">不可停靠</x:String>

        <x:String x:Key="DocumentTabStripItemFloatString">浮动</x:String>
        <x:String x:Key="DocumentTabStripItemFloatAllString">全部浮动</x:String>
        <x:String x:Key="DocumentTabStripItemCloseString">关闭</x:String>
        <x:String x:Key="DocumentTabStripItemCloseOtherTabsString">关闭其他标签页</x:String>
        <x:String x:Key="DocumentTabStripItemCloseAllTabsString">关闭所有标签页</x:String>
        <x:String x:Key="DocumentTabStripItemCloseTabsLeftString">关闭左侧标签页</x:String>
        <x:String x:Key="DocumentTabStripItemCloseTabsRightString">关闭右侧标签页</x:String>
        <x:String x:Key="DocumentTabStripItemCloseTabsAboveString">关闭上方标签页</x:String>
        <x:String x:Key="DocumentTabStripItemCloseTabsBelowString">关闭下方标签页</x:String>
        <x:String x:Key="DocumentTabStripItemNewHorizontalDockString">新建横向文档组</x:String>
        <x:String x:Key="DocumentTabStripItemNewVerticalDockString">新建纵向文档组</x:String>
        <x:String x:Key="DocumentTabStripItemTabLayoutString">标签布局</x:String>
        <x:String x:Key="DocumentTabStripItemTabLayoutLeftString">标签放在左侧</x:String>
        <x:String x:Key="DocumentTabStripItemTabLayoutTopString">标签放在顶部</x:String>
        <x:String x:Key="DocumentTabStripItemTabLayoutRightString">标签放在右侧</x:String>

        <x:String x:Key="ToolChromeControlFloatString">浮动</x:String>
        <x:String x:Key="ToolChromeControlDockString">停靠</x:String>
        <x:String x:Key="ToolChromeControlDockAsDocumentString">作为文档标签停靠</x:String>
        <x:String x:Key="ToolChromeControlAutoHideString">自动隐藏</x:String>
        <x:String x:Key="ToolChromeControlCloseString">关闭</x:String>

        <x:String x:Key="ToolPinItemControlFloatString">浮动</x:String>
        <x:String x:Key="ToolPinItemControlShowString">显示</x:String>
        <x:String x:Key="ToolPinItemControlDockAsDocumentString">作为文档标签停靠</x:String>
        <x:String x:Key="ToolPinItemControlCloseString">关闭</x:String>

        <x:String x:Key="ToolTabStripItemFloatString">浮动</x:String>
        <x:String x:Key="ToolTabStripItemFloatAllString">全部浮动</x:String>
        <x:String x:Key="ToolTabStripItemDockString">停靠</x:String>
        <x:String x:Key="ToolTabStripItemDockAsDocumentString">作为文档标签停靠</x:String>
        <x:String x:Key="ToolTabStripItemAutoHideString">自动隐藏</x:String>
        <x:String x:Key="ToolTabStripItemCloseString">关闭</x:String>

        <!-- 兼容早期自定义菜单工厂使用的通用键。 -->
        <x:String x:Key="CloseText">关闭</x:String>
        <x:String x:Key="CloseOthersText">关闭其他</x:String>
        <x:String x:Key="CloseAllText">关闭所有</x:String>
        <x:String x:Key="FloatText">浮动</x:String>
        <x:String x:Key="DockText">停靠</x:String>
        <x:String x:Key="AutoHideText">自动隐藏</x:String>
        <x:String x:Key="PinText">固定</x:String>
        <x:String x:Key="UnpinText">取消固定</x:String>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml" />
        
        <!-- 增强 Dock 窗口拖拽视觉反馈 -->
        <Style Selector="DockPanel">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- 拖拽目标区域高亮样式 -->
        <Style Selector="Border.DockTarget">
            <Setter Property="Background" Value="#4000AAFF"/>
            <Setter Property="BorderBrush" Value="#FF0078D4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        
        <Style Selector="Border.DockTarget:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- 分隔条样式增强 -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>
        
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="#0078D4"/>
        </Style>
    </Application.Styles>
</Application>